{
  "manifest_version": 2,
  "name": "LinuxDo authentication bridge",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": { "id": "linuxdo-auth@linuxdo.android" }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "cookies",
    "https://linux.do/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["https://linux.do/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
